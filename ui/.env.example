# Browser-safe Supabase Auth settings. `supabase status` prints the local URL
# and publishable/anon key. Hosted values come from the project's Connect page.
# Never put a database password, provider secret, or service-role key here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Optional cookieless Umami analytics. Leave blank locally so development and
# automated tests do not enter the production dataset. These are public values,
# not secrets.
UMAMI_HOST_URL=
UMAMI_WEBSITE_ID=
UMAMI_DOMAINS=laundrylo.com,www.laundrylo.com
