{
    "name": "laundrylo-api",
    "version": "1.0.0",
    "private": true,
    "description": "laundrylo API - /api/v1, implements docs/api-contract.md",
    "engines": {
        "node": ">=22.13.0"
    },
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/index.ts",
        "start": "node dist/index.js",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
    },
    "dependencies": {
        "@hono/node-server": "^1.14.0",
        "hono": "^4.7.0",
        "jose": "^6.0.0",
        "pg": "^8.13.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.10.2",
        "@types/pg": "^8.11.10",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "prettier": "^3.9.5",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.68.0",
        "vitest": "^4.1.10"
    }
}
