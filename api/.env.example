# Copy this file to .env. These values are safe local-development defaults for
# this repository's Supabase ports. Replace them in the deployment environment;
# never commit the resulting .env file.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321

# Local Supabase can verify HS256 tokens with its development signing secret.
# Leave this blank for hosted projects, which use SUPABASE_URL and JWKS.
SUPABASE_JWT_SECRET=

PORT=8787
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
