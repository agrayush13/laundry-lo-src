# Copy this file to .env and replace placeholders with values from your own
# local Supabase stack or hosted project. Never commit the resulting .env file.
DATABASE_URL=
SUPABASE_URL=

# Local Supabase can verify HS256 tokens with its development signing secret.
# Leave this blank for hosted projects, which use SUPABASE_URL and JWKS.
SUPABASE_JWT_SECRET=

PORT=8787
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development
